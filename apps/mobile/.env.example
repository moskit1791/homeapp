EXPO_PUBLIC_API_URL=https://app.porabkihome.pl/api

# Wymagane dla lokalnych buildow Gradle i tokenow push poza EAS.
# Po `eas init` projectId bedzie tez zapisany w `extra.eas.projectId`.
EXPO_PROJECT_ID=00000000-0000-0000-0000-000000000000

# Opcjonalnie: sciezka do pliku Firebase Android.
# Najprosciej trzymaj plik jako apps/mobile/google-services.json.
GOOGLE_SERVICES_JSON=./google-services.json

# Wymagane dla release APK instalowanego na telefonie.
# Nie buduj release APK bez Google Android OAuth Client ID.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
