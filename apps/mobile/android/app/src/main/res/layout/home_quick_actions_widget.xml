<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_quick_actions_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/home_widget_background"
  android:orientation="vertical"
  android:padding="12dp">

  <TextView
    android:id="@+id/widget_title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:fontFamily="sans"
    android:includeFontPadding="false"
    android:singleLine="true"
    android:text="Dodaj szybko"
    android:textColor="#F8FAFC"
    android:textSize="15sp"
    android:textStyle="bold" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="10dp"
    android:layout_weight="1"
    android:orientation="vertical">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:orientation="horizontal">

      <TextView
        android:id="@+id/widget_action_note"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:background="@drawable/home_widget_action_note"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="+ Notatka"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/widget_action_event"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:background="@drawable/home_widget_action_event"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="+ Wydarzenie"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/widget_action_expense"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/home_widget_action_expense"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="+ Wydatek"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_marginTop="8dp"
      android:layout_weight="1"
      android:orientation="horizontal">

      <TextView
        android:id="@+id/widget_action_shopping"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:background="@drawable/home_widget_action_shopping"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="+ Zakupy"
        android:textColor="#111827"
        android:textSize="13sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/widget_action_todo"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/home_widget_action_todo"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="+ Do zrobienia"
        android:textColor="#111827"
        android:textSize="13sp"
        android:textStyle="bold" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
