<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_single_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/home_widget_action_todo"
  android:contentDescription="@string/widget_todo_name"
  android:padding="8dp">

  <ImageView
    android:layout_width="32dp"
    android:layout_height="32dp"
    android:layout_gravity="center"
    android:contentDescription="@string/widget_todo_name"
    android:src="@drawable/ic_widget_todo" />

  <ImageView
    android:layout_width="22dp"
    android:layout_height="22dp"
    android:layout_gravity="top|end"
    android:background="@drawable/home_widget_plus_badge"
    android:contentDescription="@string/widget_add_badge"
    android:padding="4dp"
    android:src="@drawable/ic_widget_plus" />
</FrameLayout>
