{
  "cli": {
    "appVersionSource": "local",
    "version": ">= 13.0.0"
  },
  "build": {
    "development": {
      "android": {
        "buildType": "apk"
      },
      "channel": "development",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://app.porabkihome.pl/api"
      }
    },
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "channel": "preview",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://app.porabkihome.pl/api"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "channel": "production",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://app.porabkihome.pl/api"
      }
    },
    "production-apk": {
      "android": {
        "buildType": "apk"
      },
      "distribution": "internal",
      "environment": "production",
      "extends": "production",
      "channel": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
