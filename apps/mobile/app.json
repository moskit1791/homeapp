{
  "expo": {
    "name": "HomeApp",
    "slug": "homeapp",
    "scheme": "homeapp",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF",
      "dark": {
        "backgroundColor": "#0B1220"
      }
    },
    "android": {
      "package": "com.homeapp.mobile",
      "versionCode": 101,
      "permissions": [
        "POST_NOTIFICATIONS",
        "READ_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VISUAL_USER_SELECTED",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Pozwól HomeApp używać Face ID do odblokowania zaszyfrowanych danych."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "HomeApp potrzebuje dostępu do galerii, żeby dodać zdjęcie jako załącznik."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "HomeApp potrzebuje dostępu do galerii, żeby zapisać zdjęcie na telefonie.",
          "savePhotosPermission": "HomeApp potrzebuje uprawnienia do zapisywania zdjęć w galerii."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0b7a2a"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://app.porabkihome.pl/api",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "84c1efe4-53a2-451f-bf57-84228ab140f6"
      }
    }
  }
}
