{
  "name": "@homeapp/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:migrate": "ts-node --project tsconfig.json src/scripts/migrate.ts",
    "dev": "ts-node --project tsconfig.json src/main.ts",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
