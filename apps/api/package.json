  },
  "dependencies": {
    "@homeapp/shared-types": "workspace:*",
    "@homeapp/shared-validation": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "google-auth-library": "9.15.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "9.0.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@homeapp/eslint-config": "workspace:*",
    "@homeapp/tsconfig": "workspace:*",
    "@nestjs/testing": "10.4.15",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "^8.11.11",
    "@types/supertest": "6.0.2",
    "supertest": "7.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
