[Unit]
Description=Deploy HomeApp changes from origin/main
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=homeapp
WorkingDirectory=/opt/homeapp
Environment=HOMEAPP_REPO=/opt/homeapp
Environment=HOMEAPP_DEPLOY_STATE=/home/homeapp/.local/state/homeapp-deploy
Environment="GIT_SSH_COMMAND=ssh -o BatchMode=yes -o ConnectTimeout=15"
ExecStart=/bin/bash /opt/homeapp/scripts/deploy-production.sh
TimeoutStartSec=30min
KillMode=control-group
UMask=0077
